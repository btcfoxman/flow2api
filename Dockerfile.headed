FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ALLOW_DOCKER_HEADED_CAPTCHA=true \
    DISPLAY=:99 \
    PERSONAL_BROWSER_HEADLESS=0 \
    NATIVE_CDP_PROFILE_ROOT=/app/tmp/native_cdp_profiles

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        chromium \
        fluxbox \
        fonts-liberation \
        fonts-noto-cjk \
        procps \
        x11-utils \
        xauth \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

# Playwright/nodriver 旧模式也复用系统 Chromium；native_cdp 仅使用 subprocess + CDP。
COPY requirements.txt ./

RUN pip install --no-cache-dir --root-user-action=ignore -r requirements.txt

COPY . .
COPY docker/entrypoint.headed.sh /usr/local/bin/entrypoint.headed.sh
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.headed.sh && chmod +x /usr/local/bin/entrypoint.headed.sh

EXPOSE 4020

CMD ["/usr/local/bin/entrypoint.headed.sh"]
